{
  "description": "agent-guardrails: blocks destructive shell commands and asks for approval on risky ones",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/block_destructive.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
